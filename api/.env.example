# Supabase project URL, no trailing slash.
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service_role secret key. Backend only — never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase anon (public) key. Not secret — it also ships in the browser
# bundle. Used ONLY as the `apikey` header when verifying a pharmacist's
# token against GoTrue's /auth/v1/user (step 5). Never used for data access.
SUPABASE_ANON_KEY=your-anon-key

# Comma-separated allowed CORS origins, no trailing slashes.
# In prod: the Vercel production URL (plus a custom domain later).
ALLOWED_ORIGINS=http://localhost:3000

# Optional regex to allow Vercel preview deployments to call the API. Leave empty to disable.
ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app

# Echoed by /health. Render sets this to "production".
ENVIRONMENT=development

# Echoed by /health.
APP_VERSION=0.1.0

# Injected by Render; do not set locally.
# PORT=

# Secret. Keys the reporter fingerprint HMAC (step 4). Required, minimum 32
# characters — the app fails to boot if this is missing or too short.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Different values per environment are fine and expected. Rotating it resets
# all rate-limit windows.
REPORT_FINGERPRINT_SECRET=change-me-to-a-long-random-string

# Name of the single HTTP header trusted for the client IP (case-insensitive).
# Leave empty locally — the app then trusts only the raw socket address.
# On Render: cf-connecting-ip. Never a fallback chain — see
# docs/ARCHITECTURE.md 4.3.
CLIENT_IP_HEADER=
